# ==========================================================
# Contoh variabel lingkungan Z-Math
# Salin ke frontend/.env.local dan backend/.env, lalu isi nilainya.
# JANGAN commit file .env yang berisi nilai asli.
# ==========================================================

# ---------- Frontend (Vite: hanya variabel berawalan VITE_ yang terekspos) ----------
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-anon-key-di-sini
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---------- Backend (RAHASIA — hanya di server) ----------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-di-sini
SUPABASE_JWT_SECRET=isi-jwt-secret-di-sini
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost
APP_ENV=development
LOG_LEVEL=info
