        "zero": "0"
      }
    },
    "interpret": {},
    "meaning": {
      "pos": "di sebelah kanan nol",
      "neg": "di sebelah kiri nol"
    }
  },
  "temperature": {
    "unit": "°C",
    "visual": "thermometer",
    "range": [
      -20,
      20
    ],
    "step": 1,
    "fmt": {
      "state": {
        "pos": "{abs} °C",
        "neg": "−{abs} °C",
        "zero": "0 °C"
      },
      "state_words": {
        "pos": "{abs} °C di atas nol",
        "neg": "{abs} °C di bawah nol",
        "zero": "0 °C"
      },
      "change": {
        "pos": "naik {abs} °C",
        "neg": "turun {abs} °C"
      }
    },
    "interpret": {
      "state": {
        "pos": "{abs} °C di atas nol",
        "neg": "{abs} °C di bawah nol"
      },
      "change": {
