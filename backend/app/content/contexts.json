        "neg": "suhunya turun {abs} °C"
      },
      "diff": {
        "pos": "selisih suhunya {abs} °C"
      }
    },
    "meaning": {
      "pos": "di atas nol atau naik",
      "neg": "di bawah nol atau turun"
    }
  },
