        "problem": "Suhu sebuah kota −4 °C. Siang hari suhu naik 7 °C. Berapa suhu siang hari?",
        "steps": [
          {
            "text": "**Pahami**: −4 °C → −4, naik 7 °C → +7.",
            "why": "Kata 'naik' berarti positif."
          },
          {
            "text": "**Ditanya**: suhu siang hari (keadaan akhir).",
            "why": "Lihat kalimat tanya."
          },
          {
            "text": "**Model**: (−4) + 7.",
            "why": "Keadaan awal + perubahan = keadaan akhir."
          },
          {
            "text": "**Hitung**: (−4) + 7 = 3.",
            "why": "Tanda beda: 7 − 4 = 3, ikuti tanda 7 (positif)."
          },
          {
            "text": "**Tafsirkan**: suhu siang hari 3 °C di atas nol.",
            "why": "Masuk akal karena suhu naik melewati nol."
          }
        ],
        "self_explain": "Coba pikirkan: apa yang terjadi jika suhunya turun 7 °C?",
        "visual": {
          "kind": "thermometer",
          "unit": "°C",
          "range": [
            -20,
            20
          ],
          "marks": [
            {
              "value": -4,
              "label": "pagi"
            },
            {
              "value": 3,
              "label": "siang"
            }
          ],
          "arrows": [
            {
              "at": -4,
              "anchor": "from",
              "dir": "up",
              "value": 7,
              "label": "naik 7 °C"
            }
          ],
          "showEnd": true,
          "mode": "guided"
        }
      },
