# ==========================================================
# Contoh variabel lingkungan Z-Math
# Salin ke frontend/.env.local dan backend/.env, lalu isi nilainya.
# JANGAN commit file .env yang berisi nilai asli.
# ==========================================================

# ---------- Frontend (Vite: hanya variabel berawalan VITE_ yang terekspos) ----------
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-anon-key-di-sini
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---------- Backend (RAHASIA — hanya di server) ----------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-di-sini
SUPABASE_JWT_SECRET=isi-jwt-secret-di-sini
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost
APP_ENV=development
LOG_LEVEL=info

# ---------- Database (docs/DEPLOY.md) ----------
# Kosong = SQLite lokal di backend/.data/. Supabase: Project Settings → Database → Connection
# string → "Transaction pooler" (port 6543). Diubah otomatis ke postgresql+psycopg://.
# Isi nilai asli hanya di backend/.env atau di Environment Variables Vercel.
DATABASE_URL=
# psycopg (bawaan) | pg8000 (cadangan jika Windows memblokir DLL psycopg; requirements-dev.txt)
ZMATH_PG_DRIVER=psycopg

# ---------- Akun & progres ----------
# Kosong = rahasia dibuat otomatis di backend/.data/jwt_secret (lokal saja). WAJIB diisi di Vercel
ZMATH_JWT_SECRET=
# Kode pendaftaran guru dari admin sekolah. Kosong = pendaftaran guru ditutup
ZMATH_TEACHER_CODE=
# 1 = buat akun demo (guru/guru123, ayu/bima/citra kata sandi 123456). Bawaannya 1 hanya untuk
# SQLite lokal; 0 jika DATABASE_URL diisi atau di Vercel
ZMATH_SEED_DEMO=1

# ---------- Gemini (Google) ----------
# Isi nilai asli hanya di backend/.env (tidak ikut git)
GEMINI_API_KEY=isi-gemini-api-key-di-sini
# Smart Hint & Tanya Asisten: 1 = aktif (jika kunci ada), 0 = selalu petunjuk statis
ZMATH_AI_HINTS=1
# Batas waktu total menunggu Gemini (milidetik), termasuk mencoba model cadangan
ZMATH_AI_TIMEOUT_MS=12000
# Tanya Asisten (chat) boleh menunggu lebih lama: siswa melihat "Asisten sedang berpikir…"
ZMATH_ASSISTANT_TIMEOUT_MS=20000
# Kosong = otomatis: hydrogen → gemini-3-flash-preview → gemini-2.5-flash → flash lain di akun
GEMINI_MODEL=

